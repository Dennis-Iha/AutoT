# AT-CORE development container: CPU-only, matches the toolchain verified on
# the reference workstation (Debian 13 / Python 3.13 / gcc 14 / cmake 3.31).
# This is a dev environment image, not a production/embedded image - Phase 12
# will introduce a separate embedded target once hardware is selected.
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev \
    build-essential cmake pkg-config git \
    portaudio19-dev libsndfile1-dev ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY pyproject.toml README.md ./
COPY core ./core
COPY tools ./tools
COPY config ./config
COPY models/registry ./models/registry

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --upgrade pip && pip install -e ".[dev]"

COPY tests ./tests

CMD ["pytest", "-v"]
